# ==========================================================
# Demo 10-B 环境变量
# ==========================================================

# 1) 第一次运行强烈建议保持 true。
#    Mock 模式不需要任何模型 Key，也不强依赖数据库。
MOCK_MODE=true

# --------------------------
# API / Web
# --------------------------
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# --------------------------
# OpenAI-Compatible Chat Model
# 可以接 OpenAI / Qwen / DeepSeek / OpenRouter 等兼容接口。
# MOCK_MODE=false 时启用。
# --------------------------
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=qwen3.8-flash
# --------------------------
# qwen3.7-text-embedding Embedding
# 推荐本地 Ollama：
#   ollama pull qwen3.7-text-embedding
#   EMBEDDING_BASE_URL=http://localhost:11434/v1
#   EMBEDDING_API_KEY=ollama
# --------------------------
EMBEDDING_API_KEY=ollama
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSION=1024

# --------------------------
# PostgreSQL + pgvector
# docker compose 默认配置
# --------------------------
DATABASE_URL=postgresql://ai_native:ai_native@localhost:5432/ai_native

# --------------------------
# MCP
# 默认启用。Agent 会通过 stdio 启动本项目的 MCP Server。
# --------------------------
MCP_ENABLED=true

# --------------------------
# Langfuse（可选）
# 不填时 Demo 仍可运行。
# --------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --------------------------
# Sentry（可选）
# 不填时不会上传异常。
# --------------------------
SENTRY_DSN=

# --------------------------
# 飞书机器人告警（可选）
# 仅在真正发生 error 且配置后发送。
# --------------------------
FEISHU_WEBHOOK_URL=
